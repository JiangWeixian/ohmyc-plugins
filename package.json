{
  "name": "ohmyc-plugins",
  "private": true,
  "type": "module",
  "description": "OhMyC plugin marketplace",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "bun run --filter '@ohmyc/timeline-plugin' build",
    "test": "bun run --filter '@ohmyc/timeline-plugin' test",
    "test:coverage": "bun run --filter '@ohmyc/timeline-plugin' test:coverage",
    "sync:versions": "bun run scripts/sync-manifest-versions.mjs",
    "ci:version": "changeset version && bun run sync:versions",
    "ci:publish": "bun run build && changeset publish",
    "ci:snapshot": "changeset version --snapshot snapshot && bun run sync:versions",
    "ci:prerelease": "bun run build && changeset publish --no-git-tag --tag snapshot"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12"
  }
}
