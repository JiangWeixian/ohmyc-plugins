{
  "name": "@ohmyc/timeline-plugin",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiangWeixian/ohmyc-plugins.git",
    "directory": "plugins/timeline"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    ".grok-plugin",
    "assets",
    "dist",
    "hooks",
    "README.md"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup && bun build opencode.ts --outfile dist/index.js --target bun --external bun:sqlite --external @opencode-ai/plugin",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci:version": "changeset version",
    "ci:publish": "bun run build && changeset publish",
    "ci:snapshot": "changeset version --snapshot snapshot",
    "ci:prerelease": "bun run build && changeset publish --no-git-tag --tag snapshot"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.16.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@ohmyc/timeline": "file:../../vendor/ohmyc-timeline-usage-v5-8b84a5e640bd.tgz",
    "@opencode-ai/plugin": "^1.16.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.4",
    "bun-types": "^1.3.13",
    "cac": "^6.7.14",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
